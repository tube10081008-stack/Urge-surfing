# 운영 배포 환경변수 예시 — 실제 값으로 채워 .env 로 저장하거나 호스팅 대시보드에 주입.
# 로컬 PoC는 이 파일 없이도 동작(SQLite/DEBUG).

# 필수
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.example.com,localhost

# 데이터베이스 (있으면 PostgreSQL, 없으면 SQLite)
DATABASE_URL=postgres://user:password@host:5432/dbname
DJANGO_DB_SSL_REQUIRE=False

# CORS — 앱/대시보드 도메인만 허용 (비우면 전체 허용)
CORS_ALLOWED_ORIGINS=https://app.example.com

# HTTPS/보안 (역프록시 뒤라면 SSL_REDIRECT는 보통 True)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com

# Gunicorn 튜닝(선택)
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
